    "react-tads-widget": "^0.0.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
